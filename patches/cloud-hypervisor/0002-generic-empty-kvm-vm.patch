+// SPDX-License-Identifier: Apache-2.0
+//! Optional resources owned by an idle VMM and consumed by one restore.
+
+use serde::{Deserialize, Serialize};
+
+/// KVM's ordinary VM type is independent of RAM size, nested policy and SMT.
+/// Those fields affect later initialization or other backends, not create_vm.
+pub(crate) fn compatible_vm_type(_config: &hypervisor::HypervisorVmConfig) -> bool {
+    #[cfg(feature = "tdx")]
+    if _config.tdx_enabled {
+        return false;
+    }
+    #[cfg(feature = "sev_snp")]
+    if _config.sev_snp_enabled {
+        return false;
+    }
+    true
+}
+
+#[cfg(test)]
+mod vm_type_tests {
+    use super::*;
+    #[test]
+    fn ordinary_cpu_policy_does_not_change_kvm_vm_type() {
+        let mut config = hypervisor::HypervisorVmConfig {
+            #[cfg(feature = "tdx")]
+            tdx_enabled: false,
+            #[cfg(feature = "sev_snp")]
+            sev_snp_enabled: false,
+            #[cfg(feature = "sev_snp")]
+            mem_size: 256 * 1024 * 1024,
+            #[cfg(feature = "sev_snp")]
+            vmsa_features: 0,
+            nested: false,
+            smt_enabled: false,
+        };
+        config.nested = true;
+        config.smt_enabled = true;
+        assert!(compatible_vm_type(&config));
+        #[cfg(feature = "tdx")]
+        {
+            config.tdx_enabled = true;
+            assert!(!compatible_vm_type(&config));
+            config.tdx_enabled = false;
+        }
+        #[cfg(feature = "sev_snp")]
+        {
+            config.mem_size = 256 * 1024 * 1024;
+            assert!(compatible_vm_type(&config));
+            config.sev_snp_enabled = true;
+            assert!(!compatible_vm_type(&config));
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct PrepareConfig {}
+
+#[derive(Serialize)]
+pub struct PrepareResponse {
+    pub vm: bool,
+}
+
+/// Preparation is limited to the KVM architectures with descriptor support.
+pub fn supported(hypervisor: &dyn hypervisor::Hypervisor) -> bool {
+    #[cfg(all(feature = "kvm", any(target_arch = "x86_64", target_arch = "aarch64")))]
+    {
+        hypervisor.hypervisor_type() == hypervisor::HypervisorType::Kvm
+    }
+    #[cfg(not(all(feature = "kvm", any(target_arch = "x86_64", target_arch = "aarch64"))))]
+    {
+        let _ = hypervisor;
+        false
+    }
+}
