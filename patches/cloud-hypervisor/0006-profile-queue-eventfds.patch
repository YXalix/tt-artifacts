         };
@@ -2861,6 +2862,7 @@ fn vmm_prepare(&mut self, config: prewarm::PrepareConfig) -> result::Result<Vec<
             vm: true,
             vcpus: config.vcpu_ids.len(),
             workers: kinds.len(),
+            eventfds,
         })
         .map_err(|error| VmError::Prepare(error.into()))
     }
