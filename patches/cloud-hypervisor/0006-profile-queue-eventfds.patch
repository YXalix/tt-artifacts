diff --git a/vmm/src/lib.rs b/vmm/src/lib.rs
index 5123aa83b..22c7f79a3 100644
--- a/vmm/src/lib.rs
+++ b/vmm/src/lib.rs
@@ -2847,11 +2847,12 @@ fn vmm_prepare(&mut self, config: prewarm::PrepareConfig) -> result::Result<Vec<
                 .map_err(VmError::Prepare)?;
         }
         let kinds = config.worker_kinds().map_err(VmError::Prepare)?;
+        let eventfds = config.queue_count().map_err(VmError::Prepare)?;
         let devices = if kinds.is_empty() {
