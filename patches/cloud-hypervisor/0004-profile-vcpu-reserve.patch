+    #[cfg(any(target_arch = "x86_64", target_arch = "aarch64"))]
+    fn prepare_vcpus(&self, ids: &[u32]) -> anyhow::Result<()> {
+        if ids.len() > 256 {
+            anyhow::bail!("VCPU reserve exceeds limit");
+        }
+        let mut reserve = self.prepared_vcpus.lock().unwrap();
