-pub struct PrepareConfig {}
+pub struct PrepareConfig {
+    #[serde(default)]
+    pub vcpu_ids: Vec<u32>,
+}
+
+impl PrepareConfig {
+    pub fn validate(&self) -> anyhow::Result<()> {
+        if self.vcpu_ids.len() > 256
+            || self
+                .vcpu_ids
+                .iter()
+                .enumerate()
+                .any(|(i, &id)| id as usize != i)
+        {
+            anyhow::bail!("VCPU IDs must be consecutive from zero and bounded by 256");
+        }
+        Ok(())
+    }
+}
 
 #[derive(Serialize)]
 pub struct PrepareResponse {
     pub vm: bool,
+    pub vcpus: usize,
