+    #[test]
+    fn reject_invalid_cpu_profile_before_preparing_resources() {
+        for ids in [vec![1], vec![0, 0], vec![0, 2], (0..257).collect()] {
+            PrepareConfig { vcpu_ids: ids }.validate().unwrap_err();
+        }
+        PrepareConfig::default().validate().unwrap();
+        PrepareConfig {
+            vcpu_ids: vec![0, 1],
+        }
+        .validate()
+        .unwrap();
+    }
+}
