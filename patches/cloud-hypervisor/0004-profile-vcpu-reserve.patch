@@ -74,3 +95,87 @@ pub fn supported(hypervisor: &dyn hypervisor::Hypervisor) -> bool {
         false
     }
 }
+
+/// Reserved KVM vCPUs must match the actual boot IDs; unused kernel vCPUs
+/// must not remain attached to a restored VM of a different CPU profile.
+pub fn validate_vcpu_ids(ids: &[u32], config: &CpusConfig) -> anyhow::Result<()> {
+    if ids.is_empty() {
+        return Ok(());
+    }
+    if ids.len() != config.boot_vcpus as usize {
+        anyhow::bail!("Prepared vCPU count does not match restore configuration");
+    }
+    #[cfg(target_arch = "x86_64")]
+    let topology = config.topology.as_ref().map(|t| {
+        (
+            t.threads_per_core,
+            t.cores_per_die,
+            t.dies_per_package,
+            t.packages,
+        )
+    });
+    #[cfg(target_arch = "x86_64")]
+    if topology.is_some_and(|(a, b, c, d)| a == 0 || b == 0 || c == 0 || d == 0) {
+        anyhow::bail!("Invalid prepared CPU topology");
+    }
+    for (index, &id) in ids.iter().enumerate() {
+        #[cfg(target_arch = "x86_64")]
+        let expected = arch::x86_64::get_x2apic_id(index as u32, topology);
+        #[cfg(not(target_arch = "x86_64"))]
+        let expected = index as u32;
+        if id != expected {
+            anyhow::bail!("Prepared vCPU IDs do not match restore topology");
+        }
+    }
+    Ok(())
+}
