+#[cfg(test)]
+mod cpu_binding_tests {
+    use super::*;
+    #[test]
+    fn reject_extra_reserved_vcpus_and_topology_mismatch() {
+        let config = CpusConfig {
+            boot_vcpus: 2,
+            max_vcpus: 2,
+            ..Default::default()
+        };
+        validate_vcpu_ids(&[0, 1], &config).unwrap();
+        validate_vcpu_ids(&[0, 1, 2], &config).unwrap_err();
+        validate_vcpu_ids(&[0], &config).unwrap_err();
+        validate_vcpu_ids(&[], &config).unwrap();
+        #[cfg(target_arch = "x86_64")]
+        {
+            use crate::vm_config::CpuTopology;
+            let config = CpusConfig {
+                boot_vcpus: 6,
+                max_vcpus: 6,
+                topology: Some(CpuTopology {
+                    threads_per_core: 1,
+                    cores_per_die: 3,
+                    dies_per_package: 2,
+                    packages: 1,
+                }),
+                ..Default::default()
+            };
+            validate_vcpu_ids(&[0, 1, 2, 3, 4, 5], &config).unwrap_err();
+        }
+    }
