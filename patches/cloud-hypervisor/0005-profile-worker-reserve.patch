diff --git a/virtio-devices/src/prepared.rs b/virtio-devices/src/prepared.rs
new file mode 100644
index 000000000..667e80d85
--- /dev/null
+++ b/virtio-devices/src/prepared.rs
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Bounded, single-use device resources with explicit VM ownership.
+
+use std::sync::{Mutex, mpsc};
+use std::thread::{self, JoinHandle};
+use std::{io, mem, ptr};
+
+use seccompiler::SeccompAction;
+
+use crate::seccomp_filters::Thread;
+
+pub struct DeviceResources {
+    workers: Mutex<Vec<PreparedWorker>>,
+    creator: thread::ThreadId,
+    environment: ThreadEnvironment,
+}
+
+// Thread creation inherits placement and signal/scheduler policy. Compare the
+// dispatching VMM context with the preparation context before reusing a worker.
+#[derive(PartialEq, Eq)]
+struct ThreadEnvironment {
+    affinity: Vec<u8>,
+    blocked_signals: u64,
+    policy: i32,
+    priority: i32,
+}
+
+impl ThreadEnvironment {
+    fn capture() -> io::Result<Self> {
+        let mut affinity = vec![0u8; 128];
+        loop {
+            // SAFETY: The kernel writes at most affinity.len() bytes to this
+            // live, writable buffer; the syscall accepts an unaligned bitmap.
+            let result = unsafe {
+                libc::syscall(
+                    libc::SYS_sched_getaffinity,
+                    0,
+                    affinity.len(),
+                    affinity.as_mut_ptr(),
+                )
+            };
+            if result >= 0 {
+                break;
+            }
+            let error = io::Error::last_os_error();
+            if error.raw_os_error() != Some(libc::EINVAL) || affinity.len() >= 8192 {
+                return Err(error);
+            }
+            affinity.resize(affinity.len() * 2, 0);
+        }
+        // SAFETY: Both output objects are initialized before use and pointers
+        // refer to live storage. A null new mask only queries the current mask.
+        let (blocked_signals, policy, priority) = unsafe {
+            let mut mask: libc::sigset_t = mem::zeroed();
+            let result = libc::pthread_sigmask(libc::SIG_SETMASK, ptr::null(), &mut mask);
+            if result != 0 {
+                return Err(io::Error::from_raw_os_error(result));
+            }
+            let mut blocked = 0;
+            for signal in 1..=64 {
+                if libc::sigismember(&mask, signal) == 1 {
+                    blocked |= 1u64 << (signal - 1);
+                }
+            }
+            let mut param: libc::sched_param = mem::zeroed();
+            let policy = libc::syscall(libc::SYS_sched_getscheduler, 0) as i32;
+            if policy < 0 || libc::syscall(libc::SYS_sched_getparam, 0, &mut param) < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            (blocked, policy, param.sched_priority)
+        };
+        Ok(Self {
+            affinity,
+            blocked_signals,
+            policy,
+            priority,
+        })
+    }
+}
+
+type Job = Box<dyn FnOnce() + Send>;
+
+struct PreparedWorker {
+    kind: Thread,
+    action: SeccompAction,
+    sender: Option<mpsc::Sender<Job>>,
+    handle: Option<JoinHandle<()>>,
+}
+
+impl Drop for PreparedWorker {
+    fn drop(&mut self) {
+        // Closing the channel wakes an unused worker. Always join it, including
+        // when later thread creation fails partway through preparation.
+        self.sender.take();
+        if let Some(handle) = self.handle.take() {
+            let _ = handle.join();
+        }
+    }
+}
+
+impl DeviceResources {
+    pub fn new(action: &SeccompAction, kinds: &[Thread]) -> io::Result<Self> {
+        if kinds.len() > 256 {
+            return Err(io::Error::other("Worker reserve exceeds limit"));
+        }
+        let environment = ThreadEnvironment::capture()?;
+        let mut prepared = Vec::new();
+        for &kind in kinds {
+            let (sender, receiver) = mpsc::channel::<Job>();
+            let (ready_tx, ready_rx) = mpsc::sync_channel(1);
+            let handle = thread::Builder::new()
+                .name(format!("{kind:?}"))
+                .spawn(move || {
+                    if ready_tx.send(()).is_ok()
+                        && let Ok(job) = receiver.recv()
+                    {
+                        job();
+                    }
+                })?;
+            let worker = PreparedWorker {
+                kind,
+                action: action.clone(),
+                sender: Some(sender),
+                handle: Some(handle),
+            };
+            ready_rx
+                .recv()
+                .map_err(|_| io::Error::other("Prepared worker exited"))?;
+            prepared.push(worker);
+        }
+        Ok(Self {
+            workers: Mutex::new(prepared),
+            creator: thread::current().id(),
+            environment,
+        })
+    }
+
+    pub(crate) fn spawn<F>(
+        &self,
+        name: &str,
+        kind: Thread,
+        action: &SeccompAction,
+        job: F,
+    ) -> io::Result<JoinHandle<()>>
+    where
+        F: FnOnce() + Send + 'static,
+    {
+        // Reuse only on the creating VMM thread; other activation contexts
+        // keep their normal thread inheritance and allocation path.
+        if thread::current().id() != self.creator
+            || ThreadEnvironment::capture().map_or(true, |current| current != self.environment)
+        {
+            return thread::Builder::new().name(name.to_owned()).spawn(job);
+        }
+        let worker = {
+            let mut workers = self.workers.lock().unwrap();
+            workers
+                .iter()
+                .position(|w| w.kind == kind && w.action == *action)
+                .map(|index| workers.remove(index))
+        };
+        if let Some(mut worker) = worker {
+            worker
+                .sender
+                .take()
+                .unwrap()
+                .send(Box::new(job))
+                .map_err(|_| io::Error::other("Prepared worker disconnected"))?;
+            Ok(worker.handle.take().unwrap())
+        } else {
+            thread::Builder::new().name(name.to_owned()).spawn(job)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use super::*;
+    #[test]
+    fn unused_workers_join_and_dispatched_jobs_survive_reserve_drop() {
+        let resources = DeviceResources::new(
+            &SeccompAction::Allow,
+            &[Thread::VirtioBlock, Thread::VirtioNet],
+        )
+        .unwrap();
+        let reserved_id = resources.workers.lock().unwrap()[0]
+            .handle
+            .as_ref()
+            .unwrap()
+            .thread()
+            .id();
+        let (tx, rx) = mpsc::channel();
+        let handle = resources
+            .spawn(
+                "test-worker",
+                Thread::VirtioBlock,
+                &SeccompAction::Allow,
+                move || {
+                    tx.send(thread::current().id()).unwrap();
+                },
+            )
+            .unwrap();
+        drop(resources);
+        handle.join().unwrap();
+        assert_eq!(rx.recv().unwrap(), reserved_id);
+    }
+    #[test]
+    fn changed_environment_and_foreign_dispatch_do_not_consume_workers() {
+        let mut resources =
+            DeviceResources::new(&SeccompAction::Allow, &[Thread::VirtioBlock]).unwrap();
+        // Model a changed policy without changing the test runner's scheduler.
+        resources.environment.priority += 1;
+        resources
+            .spawn(
+                "fallback",
+                Thread::VirtioBlock,
+                &SeccompAction::Allow,
+                || {},
+            )
+            .unwrap()
+            .join()
+            .unwrap();
+        assert_eq!(resources.workers.lock().unwrap().len(), 1);
+        resources.environment.priority -= 1;
+        let resources = Arc::new(resources);
+        let foreign = resources.clone();
+        thread::spawn(move || {
+            foreign
+                .spawn("foreign", Thread::VirtioBlock, &SeccompAction::Allow, || {})
+                .unwrap()
+                .join()
+                .unwrap();
+        })
+        .join()
+        .unwrap();
+        assert_eq!(resources.workers.lock().unwrap().len(), 1);
+        resources
+            .spawn(
+                "wrong-kind",
+                Thread::VirtioNet,
+                &SeccompAction::Allow,
+                || {},
+            )
+            .unwrap()
+            .join()
+            .unwrap();
+        resources
+            .spawn(
+                "wrong-action",
+                Thread::VirtioBlock,
+                &SeccompAction::Trap,
+                || {},
+            )
+            .unwrap()
+            .join()
+            .unwrap();
+        assert_eq!(resources.workers.lock().unwrap().len(), 1);
+        resources
+            .spawn("match", Thread::VirtioBlock, &SeccompAction::Allow, || {})
+            .unwrap()
+            .join()
+            .unwrap();
+        assert!(resources.workers.lock().unwrap().is_empty());
+        assert!(
+            DeviceResources::new(&SeccompAction::Allow, &vec![Thread::VirtioBlock; 257]).is_err()
+        );
+    }
+}
