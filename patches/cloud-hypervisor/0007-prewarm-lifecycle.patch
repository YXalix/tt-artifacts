-/// Restore owns the VM and all remaining device reservations together.
+/// Every idle phase owns its resources. Taking this value transfers the whole
+/// preparation; a failed transition drops the VM and its kernel descriptors.
+pub(crate) enum Preparation {
+    Generic(Arc<dyn hypervisor::Vm>),
+    Profile {
+        vm: Arc<dyn hypervisor::Vm>,
+        profile: PrepareConfig,
+        devices: Option<Arc<DeviceResources>>,
+    },
+}
+
 pub struct PreparedVm {
     pub vm: Arc<dyn hypervisor::Vm>,
     pub devices: Option<Arc<DeviceResources>>,
 }
+
+impl Preparation {
+    pub(crate) fn profile(&self) -> PrepareConfig {
+        match self {
+            Self::Generic(_) => PrepareConfig::default(),
+            Self::Profile { profile, .. } => profile.clone(),
+        }
+    }
+
+    pub(crate) fn into_vm(self) -> PreparedVm {
+        match self {
+            Self::Generic(vm) => PreparedVm { vm, devices: None },
+            Self::Profile { vm, devices, .. } => PreparedVm { vm, devices },
+        }
+    }
+}
+
+pub fn validate_profile_transition(
+    current: Option<&PrepareConfig>,
+    next: &PrepareConfig,
+) -> anyhow::Result<()> {
+    next.validate()?;
+    if current.is_some_and(|profile| *profile != PrepareConfig::default() && profile != next) {
+        anyhow::bail!("Preparation is already bound to a different profile");
+    }
+    Ok(())
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+pub struct Capabilities {
+    pub version: u32,
+    pub generic_prepare: bool,
+    pub profile_prepare: bool,
+}
+
+#[cfg(test)]
+mod transition_tests {
+    use super::*;
+    #[test]
+    fn only_generic_preparation_can_change_profile() {
+        let generic = PrepareConfig::default();
+        let one = PrepareConfig {
+            vcpu_ids: vec![0],
+            ..Default::default()
+        };
+        let two = PrepareConfig {
+            vcpu_ids: vec![0, 1],
+            ..Default::default()
+        };
+        validate_profile_transition(None, &generic).unwrap();
+        validate_profile_transition(Some(&generic), &two).unwrap();
+        validate_profile_transition(Some(&two), &two).unwrap();
+        validate_profile_transition(Some(&two), &one).unwrap_err();
+        validate_profile_transition(Some(&two), &generic).unwrap_err();
+        let devices = PrepareConfig {
+            rng: true,
+            ..Default::default()
+        };
+        validate_profile_transition(Some(&generic), &devices).unwrap();
+        validate_profile_transition(Some(&devices), &devices).unwrap();
+        validate_profile_transition(Some(&devices), &generic).unwrap_err();
+        validate_profile_transition(Some(&devices), &two).unwrap_err();
+        serde_json::from_str::<PrepareConfig>(r#"{"workers":1}"#).unwrap_err();
+    }
+}
