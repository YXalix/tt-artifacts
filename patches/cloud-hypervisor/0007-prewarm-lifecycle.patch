 fuzz/fuzz_targets/http_api.rs             |  1 +
 vmm/src/api/mod.rs                        |  4 +-
 vmm/src/api/openapi/cloud-hypervisor.yaml | 11 +++
 vmm/src/lib.rs                            | 97 +++++++++++++++--------
 vmm/src/prewarm.rs                        | 79 +++++++++++++++++-
 6 files changed, 177 insertions(+), 39 deletions(-)

