+++ b/vmm/src/lib.rs
@@ -36,6 +36,7 @@
 use signal_hook::iterator::{Handle, Signals};
 use thiserror::Error;
 use tracer::trace_scoped;
+use virtio_devices::seccomp_filters::precompile_seccomp_filters;
 use vm_memory::bitmap::AtomicBitmap;
 use vm_memory::{Bytes, GuestAddress, GuestAddressSpace, GuestMemoryAtomic};
 use vm_migration::protocol::*;
@@ -2824,6 +2825,8 @@ fn vmm_prepare(&mut self, _config: prewarm::PrepareConfig) -> result::Result<Vec
                 "Backend does not support preparation"
             )));
         }
+        precompile_seccomp_filters(&self.seccomp_action)
+            .map_err(|error| VmError::Prepare(error.into()))?;
         self.precreated_vm = Some(Vm::create_hypervisor_vm(
             self.hypervisor.as_ref(),
             hypervisor::HypervisorVmConfig::default(),
