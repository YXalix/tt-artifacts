+package main
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestReadonlyLowerFormatsAndJournalSafety(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		erofs    bool
+		state    uint16
+		incompat uint32
+		fsType   string
+		options  string
+	}{
+		{"erofs", true, 0, 0, "erofs", ""},
+		{"clean ext4", false, 1, 0, "ext4", "noload"},
+		{"unclean ext4", false, 0, 0, "", ""},
+		{"recovery ext4", false, 1, 4, "", ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var super [100]byte
+			if tc.erofs {
+				binary.LittleEndian.PutUint32(super[:4], 0xe0f5e1e2)
+			} else {
+				binary.LittleEndian.PutUint16(super[56:58], 0xef53)
+				binary.LittleEndian.PutUint16(super[58:60], tc.state)
+				binary.LittleEndian.PutUint32(super[96:100], tc.incompat)
+			}
+			fsType, options, err := readonlyLowerType(super[:])
+			if (err != nil) != (tc.fsType == "") || fsType != tc.fsType || options != tc.options {
+				t.Fatalf("got %q %q %v", fsType, options, err)
+			}
+		})
+	}
+	if _, _, err := readonlyLowerType(make([]byte, 100)); err == nil {
+		t.Fatal("unknown filesystem accepted")
+	}
+	if _, _, err := readonlyLowerType(nil); err == nil {
+		t.Fatal("truncated superblock accepted")
+	}
+}
