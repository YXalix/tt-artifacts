+package main
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// A shared lower must never replay an ext4 journal or otherwise write its source.
+func readonlyLowerType(super []byte) (string, string, error) {
+	if len(super) < 100 {
+		return "", "", fmt.Errorf("truncated lower superblock")
+	}
+	if binary.LittleEndian.Uint32(super[:4]) == 0xe0f5e1e2 {
+		return "erofs", "", nil
+	}
+	if binary.LittleEndian.Uint16(super[56:58]) == 0xef53 {
+		if binary.LittleEndian.Uint16(super[58:60])&1 == 0 || binary.LittleEndian.Uint32(super[96:100])&4 != 0 {
+			return "", "", fmt.Errorf("ext4 lower requires a clean filesystem without journal recovery")
+		}
+		return "ext4", "noload", nil
+	}
+	return "", "", fmt.Errorf("lower filesystem must be raw EROFS or ext4")
+}
+
+func mountReadonlyLower(device, target string) error {
+	file, err := os.Open(device)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	var super [100]byte
+	if _, err := file.ReadAt(super[:], 1024); err != nil {
+		return fmt.Errorf("read lower superblock: %w", err)
+	}
+	fsType, options, err := readonlyLowerType(super[:])
+	if err != nil {
+		return err
+	}
+	return unix.Mount(device, target, fsType, unix.MS_RDONLY, options)
+}
