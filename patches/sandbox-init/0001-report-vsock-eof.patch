+// buffer makes the protocol/MUX readers spin after the host closes a socket.
+func TestVsockConnReportsPeerEOF(t *testing.T) {
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &vsockConn{fd: pair[0]}
+	t.Cleanup(func() { _ = c.Close() })
+	if _, err := unix.Write(pair[1], []byte("abc")); err != nil {
+		_ = unix.Close(pair[1])
+		t.Fatal(err)
+	}
+	_ = unix.Close(pair[1])
+	buf := make([]byte, 4)
+	if n, err := c.Read(buf[:3]); n != 3 || err != nil || string(buf[:3]) != "abc" {
+		t.Fatalf("buffered bytes: n=%d err=%v data=%q", n, err, buf[:3])
+	}
+	if n, err := c.Read(buf); n != 0 || err != io.EOF {
+		t.Fatalf("peer EOF: got (%d, %v), want (0, io.EOF)", n, err)
+	}
+	if n, err := c.Read(nil); n != 0 || err != nil {
+		t.Fatalf("empty read: got (%d, %v), want (0, nil)", n, err)
+	}
+	if n, err := io.ReadFull(c, buf); n != 0 || err != io.EOF {
+		t.Fatalf("protocol reader: got (%d, %v), want (0, io.EOF)", n, err)
+	}
+}
 
